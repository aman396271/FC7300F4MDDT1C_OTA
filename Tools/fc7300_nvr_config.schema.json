{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FC7300 complete NVR configuration",
  "type": "object",
  "required": ["base_hex", "nvr_base", "nvr_size"],
  "properties": {
    "$schema": {"type": "string"},
    "chip": {"type": "string"},
    "reference": {"type": "string"},
    "base_hex": {"type": "string"},
    "expected_base_hex_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "nvr_base": {"const": "0x04400000"},
    "nvr_size": {"const": "0x800"},
    "registers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "required": ["value"],
            "properties": {"value": {"type": ["integer", "string"]}},
            "additionalProperties": false
          },
          {
            "required": ["fields"],
            "properties": {
              "fields": {
                "type": "object",
                "additionalProperties": {"type": ["boolean", "integer", "string"]}
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "ota0": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "enable_code": {"type": ["integer", "string"]},
        "low_start": {"type": ["integer", "string"]},
        "low_end": {"type": ["integer", "string"]},
        "high_start": {"type": ["integer", "string"]},
        "high_end": {"type": ["integer", "string"]},
        "version_offset": {"type": ["integer", "string"]},
        "version_select": {"type": ["integer", "string"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
